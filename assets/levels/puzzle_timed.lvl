# World 1 - Puzzle A: Timed Dash
# Press the button and dash across the platforms before the countdown expires!

name Timed Dash
world 1
killY -15.0
par 25.0

# Spawn
spawn 0 1 0
box 0 -0.5 0 8 1 8 0

# Button 1 (duration 5.0 seconds)
button 1 0 0 -8 5.0
box 0 -0.5 -8 4 1 4 1

# Timed Route across stepping stones
box 0 0.5 -14 3 1 3 0
box 2 1.0 -19 3 1 3 2
box -2 1.5 -24 3 1 3 1
box 0 2.0 -29 4 1 4 0

# Door 1 (linked to Button 1)
door 1 0 3.5 -32 4 4 1
box 0 1.5 -32 6 1 4 2

# Finish Zone behind Door 1
box 0 1.5 -40 8 1 8 3
finish 0 3.0 -40 4 3 4
