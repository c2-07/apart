# World 4 - Puzzle B: Ghost Duo
# Record a ghost clone to hold the button while you pass through the door!

name Ghost Duo
world 4
killY -15.0
par 30.0

# Central Spawn
spawn 0 1 0
box 0 -0.5 0 8 1 8 0

# Left Branch: Path to Pressure Plate
box -6 -0.5 -4 3 1 3 1
box -10 -0.5 -8 3 1 3 2
box -14 -0.5 -12 6 1 6 0
# Button 2 (short duration 0.5s - requires continuous holding)
button 2 -14 0 -12 0.5

# Right Branch: Path to Locked Door
box 6 -0.5 -4 3 1 3 1
box 10 -0.5 -8 3 1 3 2
box 14 -0.5 -14 6 1 6 0
# Door 2 (linked to Button 2)
door 2 14 1.5 -18 4 4 1

# Finish Zone behind Door 2
box 14 -0.5 -26 8 1 8 3
finish 14 1.0 -26 4 3 4
